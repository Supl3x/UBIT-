# Copy to .env (never commit .env). These VITE_* values are bundled into the browser, so only put public values here.

# --- Required: Supabase (Dashboard -> Project Settings -> API) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional ---
# Show the one-tap demo role buttons on the login page.
VITE_ENABLE_DEMO_LOGINS=true
# Code needed to sign up as staff. Note: this is checked in the browser, so it only deters casual sign-ups.
# For real protection create staff accounts yourself in the Supabase dashboard.
VITE_STAFF_INVITE_CODE=change-me

# Landing-page background videos (1.mp4, 3.mp4, 4.mp4), hosted in a public storage bucket, not in git.
# Example: https://YOUR-PROJECT.supabase.co/storage/v1/object/public/media
# VITE_MEDIA_BASE_URL=

# Map: the default basemap (CARTO / OpenStreetMap raster tiles) needs NO key.
# To use your own provider, give a MapLibre style URL. {key} is replaced by VITE_MAP_API_KEY.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key={key}
# VITE_MAP_API_KEY=your-maptiler-key

# --- Server secrets: NOT set here. Use `supabase secrets set ...` (see database/Schema.sql) ---
# CRON_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
# Optional real SMS / voice: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER, TWILIO_WEBHOOK_URL, TWILIO_URDU_VOICE
